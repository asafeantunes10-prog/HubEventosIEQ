{
  /*
    So para checagem de tipos das Pages Functions — nao entra no `tsc -b` da
    raiz nem no build do site. O `wrangler pages deploy` compila `functions/`
    com o proprio esbuild, sem ler este arquivo; ele existe para o editor e
    para `npm run tipos:functions` acharem um erro ANTES do deploy, em vez de
    descobrirem so quando a Function quebrar em producao.

    "types" e so `workers-types`, sem "node": o codigo aqui roda no runtime da
    Cloudflare, nao no Node — `Response`, `fetch` e companhia vem daqui, e
    misturar com os tipos do Node criaria ambiguidade entre duas versoes
    incompativeis das mesmas globais.
  */
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force"
  },
  "include": ["**/*.ts"]
}
